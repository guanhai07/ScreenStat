<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Neutral (English) strings. Every key here must also exist in
    Strings.zh-Hans.resx — LocalizationTests asserts that, because a missing
    translation silently falls back to English and is easy to miss.

    Dataset collection strings are deliberately absent: that UI only exists in
    development builds, so translating it would be waste.
  -->
