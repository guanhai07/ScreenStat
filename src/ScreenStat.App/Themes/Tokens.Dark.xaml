<!--
  Fluent colour tokens for the dark theme. Names follow WinUI so the values can
  be checked against Microsoft's own palette. Only colours live here — this is
  the dictionary SystemThemeService swaps at runtime, so anything that does not
  change between light and dark belongs in Controls.xaml instead.

  Layer and control fills are semi-transparent white, exactly as WinUI defines
  them, so a control keeps reading correctly whichever surface it sits on.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF202020" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF1C1C1C" />
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />

  <!-- Control fills: rest, hover, pressed -->
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />

  <!-- Strokes -->
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#87FFFFFF" />
  <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />

  <!--
    Accent defaults. SystemThemeService overwrites these with the user's real
    accent colour on startup and whenever it changes; the values here are the
    Windows default so the app still looks right if that lookup fails.
    Dark mode uses a lightened accent, which needs black text on top.
  -->
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF60CDFF" />
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E660CDFF" />
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC60CDFF" />
  <!-- Tint for the screen-selection rectangle: the accent at low alpha, so the
       content under it stays readable while dragging. -->
  <SolidColorBrush x:Key="AccentFillColorSelectionBrush" Color="#3360CDFF" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF000000" />

  <!-- Status. Reserved for state, never reused as decoration. -->
  <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFCE100" />
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF99A4" />
  <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF6CCB5F" />

  <!-- Screen-selection overlay -->
  <SolidColorBrush x:Key="OverlayDimBrush" Color="#99000000" />
  <SolidColorBrush x:Key="OverlayPillBrush" Color="#E6202020" />
  <SolidColorBrush x:Key="OverlayPillTextBrush" Color="#FFFFFFFF" />
</ResourceDictionary>
