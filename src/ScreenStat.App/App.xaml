<Application x:Class="ScreenStat.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Index 0 is the theme token dictionary and SystemThemeService replaces
          it in place at startup and whenever Windows switches theme. The light
          set is only the placeholder that keeps the designer and any early
          resource lookup working; do not add dictionaries before it.
        -->
        <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
