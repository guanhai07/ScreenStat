<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ScreenStat.App</RootNamespace>
    <AssemblyName>ScreenStat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>ScreenStat</Product>
    <Description>Windows screen number statistics tool</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    SlimBuild produces the framework-dependent package: a small executable that
    requires the user to install the .NET Desktop Runtime themselves, without
    the dataset collection tooling, which only exists to feed the regression
    suite and has no meaning for an end user.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(SlimBuild)' != 'true'">
    <SelfContained>true</SelfContained>
    <!-- Compression in a single file is a self-contained-only feature. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SlimBuild)' == 'true'">
    <SelfContained>false</SelfContained>
    <DefineConstants>$(DefineConstants);SCREENSTAT_SLIM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenStat.Core\ScreenStat.Core.csproj" />
  </ItemGroup>

  <!--
    Resources/Strings.Designer.cs is generated code that is committed rather
    than produced on every build, and compiled through the normal source glob.

    MSBuild can generate it (StronglyTypedFileName on the EmbeddedResource), but
    not in a way that survives WPF: XAML is compiled through a temporary project
    that does not run the generation, so every x:Static reference fails, and
    adding the file to the glob as well makes csc warn CS2002 about a duplicate
    source file. Committing it sidesteps both.

    To add a string: add it to Strings.resx and Strings.zh-Hans.resx, then add
    the matching property to Strings.Designer.cs. LocalizationTests fails if the
    two resx files drift apart.
  -->


  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
