<Window x:Class="ScreenStat.App.Views.OcrTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="OCR 原文"
        Width="640"
        Height="520"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="识别引擎返回的原始文本，未经分列或数字解析。"
               Style="{StaticResource CaptionTextStyle}"
               Margin="0,0,0,12" />

    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="4">
      <TextBox Text="{Binding OcrText, Mode=OneWay}"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               Background="Transparent"
               BorderThickness="0"
               VerticalContentAlignment="Top"
               FontFamily="Cascadia Mono, Consolas"
               HorizontalScrollBarVisibility="Auto"
               VerticalScrollBarVisibility="Auto" />
    </Border>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="复制"
              Style="{StaticResource AccentButtonStyle}"
              Margin="0,0,8,0"
              Command="{Binding CopyOcrTextCommand}" />
      <Button Content="关闭" IsCancel="True" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
