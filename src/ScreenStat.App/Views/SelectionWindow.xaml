<Window x:Class="ScreenStat.App.Views.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ScreenStat.App.Resources"
        Title="ScreenStat Selection"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Cross">
  <Grid x:Name="RootGrid" Background="#66000000">
    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
      <Path x:Name="DimPath" Fill="{DynamicResource OverlayDimBrush}" />

      <Rectangle x:Name="SelectionRectangle"
                 Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                 StrokeThickness="2"
                 Fill="{DynamicResource AccentFillColorSelectionBrush}"
                 Visibility="Collapsed" />

      <!-- Live pixel size. The dimensions decide which detector preset runs, so
           seeing them while dragging is worth the extra chrome. -->
      <Border x:Name="SizeBadge"
              Background="{DynamicResource OverlayPillBrush}"
              CornerRadius="4"
              Padding="8,4"
              Visibility="Collapsed">
        <TextBlock x:Name="SizeText"
                   Foreground="{DynamicResource OverlayPillTextBrush}"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="12"
                   Typography.NumeralAlignment="Tabular" />
      </Border>

      <Border x:Name="HintBorder"
              Canvas.Left="24"
              Canvas.Top="24"
              Background="{DynamicResource OverlayPillBrush}"
              Padding="14,9"
              CornerRadius="8">
        <TextBlock Foreground="{DynamicResource OverlayPillTextBrush}"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="14"
                   Text="{x:Static res:Strings.SelectionHint}" />
      </Border>
    </Canvas>
  </Grid>
</Window>
