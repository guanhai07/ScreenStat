<Window x:Class="ScreenStat.App.Views.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenStat Selection"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Cross">
  <Grid x:Name="RootGrid" Background="#66000000">
    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
      <Path x:Name="DimPath" Fill="#99000000" />
      <Rectangle x:Name="SelectionRectangle"
                 Stroke="#FF4FC3F7"
                 StrokeThickness="2"
                 Fill="#334FC3F7"
                 Visibility="Collapsed" />
      <Border x:Name="HintBorder"
              Canvas.Left="20"
              Canvas.Top="20"
              Background="#CC000000"
              Padding="10,6"
              CornerRadius="4">
        <TextBlock Foreground="White" Text="拖动鼠标选择区域 · ESC 取消" />
      </Border>
    </Canvas>
  </Grid>
</Window>
