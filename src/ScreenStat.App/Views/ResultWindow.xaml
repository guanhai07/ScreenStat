<Window x:Class="ScreenStat.App.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="{Binding Title}"
        Width="820"
        Height="680"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubtitleTextStyle}" />

    <!-- Warnings sit inline rather than in a dialog: the numbers behind them are
         still usable, so blocking the window would be wrong. -->
    <Border Grid.Row="1"
            Margin="0,12,0,0"
            Padding="12,8"
            CornerRadius="4"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
            BorderThickness="1">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ErrorText}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding ErrorText}" Style="{StaticResource BodyTextStyle}" />
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
        <Path Style="{StaticResource ProgressRingStyle}" HorizontalAlignment="Center">
          <Path.RenderTransform>
            <RotateTransform Angle="0" />
          </Path.RenderTransform>
          <Path.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                   From="0"
                                   To="360"
                                   Duration="0:0:1.2" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Path.Triggers>
        </Path>
        <TextBlock Text="正在加载本地识别模型并分析..."
                   Style="{StaticResource BodyTextStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,16,0,0" />
      </StackPanel>

      <TabControl ItemsSource="{Binding Columns}"
                  SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                  Visibility="{Binding HasColumns, Converter={StaticResource BoolToVis}}">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Header}" />
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <Grid Margin="0,12,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource CaptionTextStyle}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LowConfidenceCount, StringFormat=低置信度 {0} 项}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           VerticalAlignment="Center" />
                <!-- Only meaningful while collecting: restores a row OCR dropped,
                     at the position where it belongs. -->
                <Button Grid.Column="2"
                        Content="在选中行后插入"
                        Margin="12,0,0,0"
                        MinWidth="128"
                        Command="{Binding InsertRowCommand}"
                        Visibility="{Binding DataContext.HasDatasetSession, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
              </Grid>

              <!-- Headline figures as stat tiles. Values use the font's default
                   proportional figures; tabular widths make a number like 121
                   look loose at this size. -->
              <ItemsControl Grid.Row="1" ItemsSource="{Binding PrimaryStats}" Margin="-4,14,-4,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="4,0">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding Value}" Style="{StaticResource StatValueTextStyle}" Margin="0,2,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl Grid.Row="2" ItemsSource="{Binding SecondaryStats}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,4">
                      <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionTextStyle}" />
                      <TextBlock Text="{Binding Value}"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 Margin="6,0,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,14,0,0">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          Margin="8,4,8,8">
                  <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="使用"
                                            Binding="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="60">
                      <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                          <Setter Property="HorizontalAlignment" Value="Center" />
                          <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                      </DataGridCheckBoxColumn.ElementStyle>
                      <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                          <Setter Property="HorizontalAlignment" Value="Center" />
                          <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                      </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>
                    <!-- Tabular figures here, so a column of numbers lines up. -->
                    <DataGridTextColumn Header="识别数字（可直接修改）"
                                        Binding="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource TabularCellTextStyle}"
                                        Width="*">
                      <!-- The app-wide TextBox metrics are sized for forms and
                           overflow a 36px row, so the editor gets its own. -->
                      <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Setter Property="MinHeight" Value="0" />
                          <Setter Property="Padding" Value="6,2" />
                          <Setter Property="Margin" Value="6,3" />
                          <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                        </Style>
                      </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="置信度"
                                        Binding="{Binding ConfidenceText}"
                                        IsReadOnly="True"
                                        Width="84">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TabularCellTextStyle}">
                          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="来源" Binding="{Binding OriginText}" IsReadOnly="True" Width="76">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="VerticalAlignment" Value="Center" />
                          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="状态" Binding="{Binding ReviewText}" IsReadOnly="True" Width="88">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="VerticalAlignment" Value="Center" />
                          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasParseError}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </Grid>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Grid>

    <!-- Shown only while this capture is being collected as a dataset sample. -->
    <Border Grid.Row="3"
            Style="{StaticResource CardBorderStyle}"
            Padding="14"
            Margin="0,16,0,0"
            Visibility="{Binding HasDatasetSession, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="场景备注"
                   Style="{StaticResource BodyTextStyle}"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
        <TextBox Grid.Column="1"
                 Text="{Binding DatasetNote, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="例如：深色主题 / 125% DPI / 12px / 某某报表" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
          <Button Content="保存标注" Margin="0,0,8,0" Command="{Binding SaveDatasetLabelsCommand}" />
          <Button Content="作废样本" Command="{Binding DiscardDatasetCaptureCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="3"
                   Margin="0,10,0,0"
                   Text="{Binding DatasetStatusText}"
                   Style="{StaticResource CaptionTextStyle}"
                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="0,18,0,0">
      <TextBlock VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextStyle}"
                 Text="本地处理 · 不上传截图 · 取消勾选即可排除错误项" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="复制统计" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Command="{Binding CopyStatisticsCommand}" />
        <Button Content="复制数字" Margin="0,0,8,0" Command="{Binding CopyNumbersCommand}" />
        <Button Content="OCR 原文" Click="OnShowOcrTextClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
