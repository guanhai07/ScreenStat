<Window x:Class="ScreenStat.App.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenStat"
        Width="420"
        Height="520"
        MinWidth="360"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#FF1E1E1E"
        Foreground="#FFF3F3F3"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />

    <TextBlock Grid.Row="1"
               Margin="0,8,0,0"
               Text="{Binding ErrorText}"
               Foreground="#FFFFB74D"
               TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ErrorText}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <ScrollViewer Grid.Row="2" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="正在识别..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

        <TextBox Text="{Binding SummaryText, Mode=OneWay}"
                 Visibility="{Binding HasStatistics, Converter={StaticResource BoolToVis}}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="#FFF3F3F3"
                 FontFamily="Consolas"
                 FontSize="14"
                 Margin="0,0,0,12" />

        <TextBlock Text="识别数字" FontWeight="SemiBold" Margin="0,0,0,4"
                   Visibility="{Binding HasStatistics, Converter={StaticResource BoolToVis}}" />
        <TextBox Text="{Binding NumbersText, Mode=OneWay}"
                 Visibility="{Binding HasStatistics, Converter={StaticResource BoolToVis}}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 BorderThickness="1"
                 BorderBrush="#FF444444"
                 Background="#FF2B2B2B"
                 Foreground="#FFF3F3F3"
                 FontFamily="Consolas"
                 MinHeight="80"
                 Margin="0,0,0,12" />

        <TextBlock Text="OCR 原文" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox Text="{Binding OcrText, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 BorderThickness="1"
                 BorderBrush="#FF444444"
                 Background="#FF2B2B2B"
                 Foreground="#FFDDDDDD"
                 FontFamily="Consolas"
                 MinHeight="100" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="复制统计" Width="90" Margin="0,0,8,0" Padding="8,4" Command="{Binding CopyStatisticsCommand}" />
      <Button Content="复制数字" Width="90" Margin="0,0,8,0" Padding="8,4" Command="{Binding CopyNumbersCommand}" />
      <Button Content="OCR文本" Width="90" Padding="8,4" Command="{Binding CopyOcrTextCommand}" />
    </StackPanel>

    <TextBlock Grid.Row="4"
               Margin="0,12,0,0"
               Opacity="0.6"
               Text="本地处理 · 不上传截图" />
  </Grid>
</Window>
