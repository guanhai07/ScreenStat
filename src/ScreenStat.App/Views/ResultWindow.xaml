<Window x:Class="ScreenStat.App.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#FF1E1E1E"
        Foreground="#FFF3F3F3"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
    <!-- The window sets a near-white Foreground that the default light chrome
         of DataGridColumnHeader and TabItem inherits, leaving the header text
         invisible against its own background. Give both explicit dark-theme
         colours instead of relying on inheritance. -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#FF333333" />
      <Setter Property="Foreground" Value="#FFF3F3F3" />
      <Setter Property="BorderBrush" Value="#FF484848" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Background" Value="#FF2B2B2B" />
      <Setter Property="Foreground" Value="#FFDDDDDD" />
      <Setter Property="BorderBrush" Value="#FF484848" />
      <Setter Property="Padding" Value="10,5" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FF3A3A3A" />
          <Setter Property="Foreground" Value="#FFFFFFFF" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />

    <TextBlock Grid.Row="1"
               Margin="0,8,0,0"
               Text="{Binding ErrorText}"
               Foreground="#FFFFB74D"
               TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ErrorText}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Grid Grid.Row="2" Margin="0,12,0,12">
      <TextBlock Text="正在加载本地识别模型并分析..."
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

      <TabControl ItemsSource="{Binding Columns}"
                  Visibility="{Binding HasColumns, Converter={StaticResource BoolToVis}}"
                  Background="#FF252525"
                  BorderBrush="#FF484848">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Header}" Margin="8,2" />
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#FFBDBDBD" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LowConfidenceCount, StringFormat=低置信度 {0} 项}"
                           Foreground="#FFFFB74D"
                           VerticalAlignment="Center" />
                <!-- Only meaningful while collecting: lets the reviewer restore
                     a row OCR dropped, at the position where it belongs. -->
                <Button Grid.Column="2"
                        Content="在选中行后插入"
                        Margin="12,0,0,0"
                        MinWidth="120"
                        Command="{Binding InsertRowCommand}"
                        Visibility="{Binding DataContext.HasDatasetSession, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
              </Grid>

              <TextBox Grid.Row="1"
                       Margin="0,8,0,10"
                       Text="{Binding SummaryText, Mode=OneWay}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       BorderThickness="0"
                       Background="Transparent"
                       Foreground="#FFF3F3F3"
                       FontFamily="Consolas"
                       FontSize="14"
                       MinHeight="154" />

              <DataGrid Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderBrush="#FF484848"
                        Background="#FF252525"
                        Foreground="#FFF3F3F3"
                        RowBackground="#FF2B2B2B"
                        AlternatingRowBackground="#FF303030"
                        HorizontalGridLinesBrush="#FF404040">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="使用" Binding="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                  <DataGridTextColumn Header="识别数字（可直接修改）"
                                      Binding="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      Width="*" />
                  <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceText}" IsReadOnly="True" Width="75" />
                  <DataGridTextColumn Header="来源" Binding="{Binding OriginText}" IsReadOnly="True" Width="70">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FF80CBC4" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="状态" Binding="{Binding ReviewText}" IsReadOnly="True" Width="90">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFBDBDBD" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                            <Setter Property="Foreground" Value="#FFFFB74D" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding HasParseError}" Value="True">
                            <Setter Property="Foreground" Value="#FFFF6B6B" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Grid>

    <Expander Grid.Row="3" Header="查看 OCR 原文" Margin="0,0,0,12">
      <TextBox Text="{Binding OcrText, Mode=OneWay}"
               IsReadOnly="True"
               TextWrapping="Wrap"
               AcceptsReturn="True"
               BorderThickness="1"
               BorderBrush="#FF444444"
               Background="#FF2B2B2B"
               Foreground="#FFDDDDDD"
               FontFamily="Consolas"
               MinHeight="90"
               MaxHeight="180" />
    </Expander>

    <!-- Shown only while this capture is being collected as a dataset sample. -->
    <Border Grid.Row="4"
            Margin="0,0,0,12"
            Padding="10"
            Background="#FF262626"
            BorderBrush="#FF3F51B5"
            BorderThickness="1"
            Visibility="{Binding HasDatasetSession, Converter={StaticResource BoolToVis}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="场景备注" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox Grid.Column="1"
                 Text="{Binding DatasetNote, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"
                 Padding="6,3"
                 Background="#FF2B2B2B"
                 Foreground="#FFF3F3F3"
                 CaretBrush="#FFF3F3F3"
                 BorderBrush="#FF484848"
                 ToolTip="例如：深色主题 / 125% DPI / 12px / 某某报表" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
          <Button Content="保存标注" Margin="0,0,8,0" Command="{Binding SaveDatasetLabelsCommand}" />
          <Button Content="作废样本" Command="{Binding DiscardDatasetCaptureCommand}" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="3"
                   Margin="0,8,0,0"
                   Text="{Binding DatasetStatusText}"
                   Foreground="#FF9CCC65"
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Grid Grid.Row="5">
      <TextBlock VerticalAlignment="Center"
                 Opacity="0.6"
                 Text="本地处理 · 不上传截图 · 取消勾选即可排除错误项" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="复制统计" Margin="0,0,8,0" Command="{Binding CopyStatisticsCommand}" />
        <Button Content="复制数字" Margin="0,0,8,0" Command="{Binding CopyNumbersCommand}" />
        <Button Content="OCR 文本" Command="{Binding CopyOcrTextCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
