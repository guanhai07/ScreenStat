<Window x:Class="ScreenStat.App.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenStat"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#FF1E1E1E"
        Foreground="#FFF3F3F3"
        FontFamily="Segoe UI"
        FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="SemiBold" />

    <TextBlock Grid.Row="1"
               Margin="0,8,0,0"
               Text="{Binding ErrorText}"
               Foreground="#FFFFB74D"
               TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorText}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ErrorText}" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <Grid Grid.Row="2" Margin="0,12,0,12">
      <TextBlock Text="正在加载本地识别模型并分析..."
                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

      <TabControl ItemsSource="{Binding Columns}"
                  Visibility="{Binding HasColumns, Converter={StaticResource BoolToVis}}"
                  Background="#FF252525"
                  BorderBrush="#FF484848">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Header}" Margin="8,2" />
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate>
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#FFBDBDBD" />
                <TextBlock Grid.Column="1"
                           Text="{Binding LowConfidenceCount, StringFormat=低置信度 {0} 项}"
                           Foreground="#FFFFB74D" />
              </Grid>

              <TextBox Grid.Row="1"
                       Margin="0,8,0,10"
                       Text="{Binding SummaryText, Mode=OneWay}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       BorderThickness="0"
                       Background="Transparent"
                       Foreground="#FFF3F3F3"
                       FontFamily="Consolas"
                       FontSize="14"
                       MinHeight="154" />

              <DataGrid Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderBrush="#FF484848"
                        Background="#FF252525"
                        Foreground="#FFF3F3F3"
                        RowBackground="#FF2B2B2B"
                        AlternatingRowBackground="#FF303030"
                        HorizontalGridLinesBrush="#FF404040">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="使用" Binding="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                  <DataGridTextColumn Header="识别数字（可直接修改）"
                                      Binding="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      Width="*" />
                  <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceText}" IsReadOnly="True" Width="75" />
                  <DataGridTextColumn Header="状态" Binding="{Binding ReviewText}" IsReadOnly="True" Width="90">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#FFBDBDBD" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsLowConfidence}" Value="True">
                            <Setter Property="Foreground" Value="#FFFFB74D" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding HasParseError}" Value="True">
                            <Setter Property="Foreground" Value="#FFFF6B6B" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>
    </Grid>

    <Expander Grid.Row="3" Header="查看 OCR 原文" Margin="0,0,0,12">
      <TextBox Text="{Binding OcrText, Mode=OneWay}"
               IsReadOnly="True"
               TextWrapping="Wrap"
               AcceptsReturn="True"
               BorderThickness="1"
               BorderBrush="#FF444444"
               Background="#FF2B2B2B"
               Foreground="#FFDDDDDD"
               FontFamily="Consolas"
               MinHeight="90"
               MaxHeight="180" />
    </Expander>

    <Grid Grid.Row="4">
      <TextBlock VerticalAlignment="Center"
                 Opacity="0.6"
                 Text="本地处理 · 不上传截图 · 取消勾选即可排除错误项" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="复制统计" Margin="0,0,8,0" Command="{Binding CopyStatisticsCommand}" />
        <Button Content="复制数字" Margin="0,0,8,0" Command="{Binding CopyNumbersCommand}" />
        <Button Content="OCR 文本" Command="{Binding CopyOcrTextCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
