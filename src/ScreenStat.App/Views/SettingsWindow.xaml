<Window x:Class="ScreenStat.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:ScreenStat.App.Resources"
        Style="{StaticResource AppWindowStyle}"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <StackPanel Margin="24,20,24,20">

    <!-- Hotkey -->
    <TextBlock Text="{x:Static res:Strings.SettingsHotkey}" Style="{StaticResource BodyStrongTextStyle}" />
    <TextBlock Text="{x:Static res:Strings.SettingsHotkeyHint}"
               Style="{StaticResource CaptionTextStyle}"
               Margin="0,4,0,8" />
    <!-- A focusable border rather than a TextBox: the value is a key
         combination, not text, and a TextBox would try to insert characters. -->
    <Border x:Name="HotkeyBox"
            Focusable="True"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="12,9"
            Cursor="Hand"
            PreviewKeyDown="OnHotkeyBoxKeyDown"
            GotKeyboardFocus="OnHotkeyBoxGotFocus"
            LostKeyboardFocus="OnHotkeyBoxLostFocus"
            MouseLeftButtonDown="OnHotkeyBoxClick">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter Property="BorderThickness" Value="1,1,1,2" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding HotkeyText}" Style="{StaticResource BodyTextStyle}" />
    </Border>

    <!-- Language -->
    <TextBlock Text="{x:Static res:Strings.SettingsLanguage}"
               Style="{StaticResource BodyStrongTextStyle}"
               Margin="0,20,0,0" />
    <TextBlock Text="{x:Static res:Strings.SettingsLanguageNote}"
               Style="{StaticResource CaptionTextStyle}"
               Margin="0,4,0,8" />
    <ComboBox ItemsSource="{Binding Languages}"
              DisplayMemberPath="Display"
              SelectedValuePath="Value"
              SelectedValue="{Binding Language, Mode=TwoWay}"
              MinHeight="32"
              Padding="10,6" />

    <TextBlock Text="{Binding Message}"
               Margin="0,16,0,0"
               TextWrapping="Wrap">
      <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMessageError}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="{x:Static res:Strings.CommonSave}"
              Style="{StaticResource AccentButtonStyle}"
              Margin="0,0,8,0"
              Command="{Binding SaveCommand}" />
      <Button Content="{x:Static res:Strings.CommonCancel}" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>
  </StackPanel>
</Window>
